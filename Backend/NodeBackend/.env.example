PORT=8000
MONGO_URI=mongodb://localhost:27017/hirehub
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# ── File storage (Cloudinary) ──────────────────────────────────
# Sign up free at https://cloudinary.com — add these 3 vars in Render env
# Leave blank in local dev to fall back to local ./uploads folder
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Gmail Notifications (Login alerts, welcome emails, password resets) ──
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and App Password below:
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME="HireHub Security"

# ── Production values (set these in Render environment variables) ──
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/hirehub?retryWrites=true&w=majority
# FRONTEND_ORIGIN=https://your-app.vercel.app
# NODE_ENV=production
