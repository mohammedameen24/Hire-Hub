PORT=8000
MONGO_URI=mongodb://localhost:27017/hirehub
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=your_gemini_api_key_here
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# ── File storage ───────────────────────────────────────────────
# Leave empty locally (defaults to ./uploads).
# On Render: set to the mount path of your Render Disk, e.g. /var/data/uploads
UPLOAD_DIR=

# ── Production values (set these in Render environment variables) ──
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/hirehub?retryWrites=true&w=majority
# FRONTEND_ORIGIN=https://your-app.vercel.app
# NODE_ENV=production
